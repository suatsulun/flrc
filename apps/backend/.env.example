ENV=dev
DATABASE_URL=postgresql+asyncpg://flrc:flrc@localhost:5432/flrc
DATABASE_URL_DIRECT=postgresql+asyncpg://flrc:flrc@localhost:5432/flrc
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-me-48-random-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAIN=yourschool.k12.tr
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
TRUSTED_HOSTS=localhost,127.0.0.1
# School mode only. Store the same random value as an encrypted
# GATEWAY_SECRET binding on the Cloudflare Worker.
GATEWAY_SECRET=
SESSION_TTL_SECONDS=28800
MAX_REQUEST_BODY_BYTES=12582912
WORKER_HEALTH_URL=
OPS_TOKEN=change-me
# Public demo only (ENV=demo): any verified Google account becomes a temporary
# administrator that lives at most 24 hours. Refused at startup in every other
# ENV. Keep ALLOWED_GOOGLE_DOMAIN on the synthetic seed domain when enabling it.
DEMO_PUBLIC_LOGIN=false
DEMO_VISITOR_LIMIT_PER_DAY=500
# Nightly demo reset (ENV=demo, ADR-052): the demo branch is restored from its
# pristine parent at local midnight. Public login refuses to start without it.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_DEMO_BRANCH_ID=
NEON_GOLDEN_BRANCH_ID=
DEMO_RESET_TIMEZONE=Europe/Istanbul
# Direct URL of the golden parent branch; the start script migrates and seeds
# it before the demo branch so a reset can never revert a release.
DATABASE_URL_GOLDEN_DIRECT=
# Report-card branding. Normally leave BOTH of these empty: the school's name and
# logo come from the repository's `branding/` folder, which `pnpm brand` syncs
# into the reports package. Set them only to override that for one deployment,
# e.g. when one codebase serves several schools. See branding/README.md.
SCHOOL_NAME=
SCHOOL_LOGO_PATH=
# A deployment's branding overlay folder (brand.json + logo.svg), the same one
# the web image serves at /branding/. Takes precedence over the synced assets.
SCHOOL_BRANDING_DIR=
