# FL-ReportCard school server environment. Copy to /srv/flrc/.env on the server
# and fill every value; never commit the filled file. The API refuses to start
# with placeholder or short secrets (docs/SECURITY.md).

# Public hostname. Caddy obtains and renews the certificate automatically; ports
# 80 and 443 must be reachable from the internet and DNS must point here.
SITE_ADDRESS=flrc.school.k12.tr
FRONTEND_ORIGIN=https://flrc.school.k12.tr
ADMIN_ORIGIN=https://flrc.school.k12.tr
# The public hostname plus "localhost" for the container health probe.
TRUSTED_HOSTS=flrc.school.k12.tr,localhost

# Google Workspace: the school's own Internal OAuth client with exactly one
# redirect URI, https://<SITE_ADDRESS>/api/auth/callback.
ALLOWED_GOOGLE_DOMAIN=school.k12.tr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Three different random values: openssl rand -base64 48
SESSION_SECRET=
GATEWAY_SECRET=
OPS_TOKEN=

SESSION_TTL_SECONDS=28800
MAX_REQUEST_BODY_BYTES=12582912

# Database (internal network only). Password: openssl rand -hex 24
POSTGRES_USER=flrc
POSTGRES_PASSWORD=
POSTGRES_DB=flrc
# Repeat the password in both URLs; the same server serves app and migrations.
DATABASE_URL=postgresql+asyncpg://flrc:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/flrc
DATABASE_URL_DIRECT=postgresql+asyncpg://flrc:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/flrc
REDIS_URL=redis://redis:6379/0

# Backups (ADR-056): nightly age-encrypted dumps to the school's Shared Drive,
# the last seven kept, a restore test on the first of each month, and one
# archive bundle per closed academic year. Generate the key pair with
#   docker compose run --rm backup flrc backup keygen
# and keep the identity in the school's password manager plus a sealed copy.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
# The service account's JSON key on ONE line, and the id of the backup folder
# inside the school's Shared Drive of which the account is a member.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_BACKUP_FOLDER_ID=
BACKUP_AT=02:30
BACKUP_RETAIN=7
BACKUP_RESTORE_TEST_DAY=1
BACKUP_TIMEZONE=Europe/Istanbul

# Optional: a school-approved Sentry project (scrubbed; see docs/SECURITY.md).
SENTRY_DSN=
